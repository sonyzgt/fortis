{
  "name": "poker-online-privy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,NEXT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:next\"",
    "dev:next": "next dev -p 3000",
    "dev:server": "tsx watch server/index.ts",
    "build:next": "next build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:next && npm run build:server",
    "start": "node dist-server/index.js",
    "test": "tsx server/test/evaluator.test.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.38.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.475.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
